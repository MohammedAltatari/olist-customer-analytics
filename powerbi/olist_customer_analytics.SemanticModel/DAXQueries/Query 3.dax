EVALUATE
ADDCOLUMNS (
    SELECTCOLUMNS ( { 2017, 2018 }, "Yr", [Value] ),
    "PBI_Revenue", VAR y = [Yr] RETURN CALCULATE ( [Revenue], DimDate[year] = y ),
    "SQL_Revenue", VAR y = [Yr] RETURN SUMX ( FILTER ( MonthlyKPIs, LEFT ( MonthlyKPIs[purchase_month], 4 ) = FORMAT ( y, "0" ) ), MonthlyKPIs[revenue] ),
    "PBI_Orders", VAR y = [Yr] RETURN CALCULATE ( [Orders], DimDate[year] = y ),
    "SQL_Orders", VAR y = [Yr] RETURN SUMX ( FILTER ( MonthlyKPIs, LEFT ( MonthlyKPIs[purchase_month], 4 ) = FORMAT ( y, "0" ) ), MonthlyKPIs[orders] ),
    "PBI_AOV", VAR y = [Yr] RETURN ROUND ( CALCULATE ( [AOV], DimDate[year] = y ), 2 ),
    "PBI_Repeat_pct", VAR y = [Yr] RETURN ROUND ( CALCULATE ( [Repeat Customer %], DimDate[year] = y ) * 100, 2 ),
    "PBI_Late_pct", VAR y = [Yr] RETURN ROUND ( CALCULATE ( [Late Rate %], DimDate[year] = y ) * 100, 2 )
)