// 3.2_measures.dax - core measures + checks vs SQL
DEFINE
    MEASURE '_Measures'[Revenue] =
        CALCULATE ( SUM ( FactOrders[items_value] ), FactOrders[is_delivered] = TRUE () )

    MEASURE '_Measures'[Orders] =
        CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[is_delivered] = TRUE () )

    MEASURE '_Measures'[AOV] =
        DIVIDE ( [Revenue], [Orders] )

    MEASURE '_Measures'[Customers] =
        CALCULATE ( DISTINCTCOUNT ( FactOrders[customer_key] ), FactOrders[is_delivered] = TRUE () )

    MEASURE '_Measures'[Repeat Customers] =
        VAR CustomersInContext =
            CALCULATETABLE ( VALUES ( FactOrders[customer_key] ), FactOrders[is_delivered] = TRUE () )
        RETURN
            COUNTROWS ( FILTER ( CustomersInContext, [Orders] >= 2 ) )

    MEASURE '_Measures'[Repeat Customer %] =
        DIVIDE ( [Repeat Customers], [Customers] )

    MEASURE '_Measures'[Late Orders] =
        CALCULATE ( [Orders], FactOrders[is_late] = TRUE () )

    MEASURE '_Measures'[Orders with Delivery Date] =
        CALCULATE ( [Orders], NOT ISBLANK ( FactOrders[is_late] ) )

    MEASURE '_Measures'[Late Rate %] =
        DIVIDE ( [Late Orders], [Orders with Delivery Date] )

EVALUATE
ROW (
    "Revenue", [Revenue],
    "Orders", [Orders],
    "AOV", ROUND ( [AOV], 2 ),
    "Customers", [Customers],
    "Repeat Customers", [Repeat Customers],
    "Repeat %", ROUND ( [Repeat Customer %] * 100, 2 ),
    "Late %", ROUND ( [Late Rate %] * 100, 2 )
)

EVALUATE
VAR Compare =
    ADDCOLUMNS (
        MonthlyKPIs,
        "d_revenue",
            VAR m = MonthlyKPIs[purchase_month]
            RETURN CALCULATE ( [Revenue], DimDate[year_month] = m ) - MonthlyKPIs[revenue],
        "d_orders",
            VAR m = MonthlyKPIs[purchase_month]
            RETURN CALCULATE ( [Orders], DimDate[year_month] = m ) - MonthlyKPIs[orders],
        "d_customers",
            VAR m = MonthlyKPIs[purchase_month]
            RETURN CALCULATE ( [Customers], DimDate[year_month] = m ) - MonthlyKPIs[customers],
        "d_aov",
            VAR m = MonthlyKPIs[purchase_month]
            RETURN ROUND ( CALCULATE ( [AOV], DimDate[year_month] = m ), 2 ) - MonthlyKPIs[avg_order_value],
        "d_late",
            VAR m = MonthlyKPIs[purchase_month]
            RETURN ROUND ( CALCULATE ( [Late Rate %], DimDate[year_month] = m ) * 100, 1 ) - MonthlyKPIs[late_rate_pct]
    )
RETURN
    ROW (
        "months", COUNTROWS ( Compare ),
        "revenue_mismatch",   COUNTROWS ( FILTER ( Compare, ABS ( [d_revenue] ) > 0.005 ) ) + 0,
        "orders_mismatch",    COUNTROWS ( FILTER ( Compare, [d_orders] <> 0 ) ) + 0,
        "customers_mismatch", COUNTROWS ( FILTER ( Compare, [d_customers] <> 0 ) ) + 0,
        "aov_mismatch",       COUNTROWS ( FILTER ( Compare, ABS ( [d_aov] ) > 0.005 ) ) + 0,
        "late_mismatch",      COUNTROWS ( FILTER ( Compare, ABS ( [d_late] ) > 0.05 ) ) + 0
    )

EVALUATE
SUMMARIZECOLUMNS (
    CustomerSegments[segment],
    "Customers", [Customers],
    "Revenue", [Revenue],
    "AOV", ROUND ( [AOV], 2 ),
    "Repeat %", ROUND ( [Repeat Customer %] * 100, 1 ),
    "Late %", ROUND ( [Late Rate %] * 100, 1 )
)
ORDER BY [Revenue] DESC