	column 'Delivery Status' =
			IF (
			    ISBLANK ( FactOrders[is_late] ),
			    "No valid dates",
			    IF ( FactOrders[is_late], "Late", "On time" )
			)
		dataType: string
		lineageTag: 8ebe8fa8-e954-4130-8279-68bebf3a9c65
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Delay Bucket Order' =
			VAR d = FactOrders[delay_days]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( d ), 99,
			        d <= -15, 1,
			        d <= -8, 2,
			        d <= -1, 3,
			        d = 0, 4,
			        d <= 3, 5,
			        d <= 7, 6,
			        d <= 14, 7,
			        8
			    )
		dataType: int64
		formatString: 0
		lineageTag: 8ac1c38e-f50a-493b-a24e-58db6db9df26
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Delay Bucket' =
			// delay_days = delivered date - estimated date (negative = early)
			VAR d = FactOrders[delay_days]
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( d ), "No valid dates",
			        d <= -15, "15+ days early",
			        d <= -8, "8-14 days early",
			        d <= -1, "1-7 days early",
			        d = 0, "On estimated day",
			        d <= 3, "1-3 days late",
			        d <= 7, "4-7 days late",
			        d <= 14, "8-14 days late",
			        "15+ days late"
			    )
		dataType: string
		lineageTag: e3299150-ed98-4dde-8658-09fb89c06562
		summarizeBy: none
		sortByColumn: 'Delay Bucket Order'

		annotation SummarizationSetBy = Automatic

