{
  "name": "Olist Hybrid",
  "dataColors": [
    "#F28C38",
    "#3FA7D6",
    "#A9CCE3",
    "#2F6EA5",
    "#F6C28B",
    "#2E8B57",
    "#E74C3C",
    "#F2C14E"
  ],
  "foreground": "#FFFFFF",
  "foregroundNeutralSecondary": "#9FB0C7",
