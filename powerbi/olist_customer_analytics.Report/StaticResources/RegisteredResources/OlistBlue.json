              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#33475B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#33475B"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F3F7FB"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3EAF2"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#E3EAF2"
              }
            }
          }
        ],
        "rowTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B2340"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FDE7D3"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "columnTotal": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B2340"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FDE7D3"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#F28C38"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#0A1628"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#D5DEEA"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "label": [
          {
            "color": {
              "solid": {
                "color": "#D5DEEA"
              }
            }
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0B2340"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1F4E79"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#F28C38"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          },
          {
            "$id": "selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ]
      }
