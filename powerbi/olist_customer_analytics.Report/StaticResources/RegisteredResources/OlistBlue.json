        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B7F"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#5B6B7F"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E3EAF2"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B7F"
              }
